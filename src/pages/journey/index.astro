---
import Base from '../../layouts/Base.astro';

const title = 'The sign-in journey';
const description = 'One sign-in, followed through the Biira Bank lab: the workstation, the domain controller, the firewall, the identity providers and the SIEM. Scroll to follow it.';

const scenes = [
  { from: 0.0, to: 0.13, n: '01', k: 'Sign-in', h: 'One request.', p: 'A user on WKS01 signs in to corp.biirabank.com. Scroll to follow that one request through the lab.' },
  { from: 0.15, to: 0.30, n: '02', k: 'Directory', h: 'Checked at home first.', p: 'The request reaches DC01, the domain controller on VLAN 50. Active Directory checks the password and issues a Kerberos ticket. Nothing has left the segment yet.' },
  { from: 0.32, to: 0.44, n: '03', k: 'Firewall', h: 'Default deny.', p: 'To reach the cloud, DC01 must cross pfSense. Every interface denies by default; one written, justified rule lets this traffic out, and nothing comes back in uninvited.' },
  { from: 0.45, to: 0.57, n: '04', k: 'Identity', h: 'Verified, then verified again.', p: 'Entra ID and Okta check the device and the second factor. No single system says yes on its own. The providers are reached from DC01, never the other way round.' },
  { from: 0.60, to: 0.78, n: '05', k: 'Detection', h: 'On the record.', p: 'Every step was logged. Agents on WKS01 and DC01 ship their events through the firewall to SIEM01 on VLAN 20, where Wazuh decodes each one, alerts on the few that matter, and keeps the rest.' },
  { from: 0.80, to: 0.91, n: '06', k: 'The estate', h: 'Built, documented, proven.', p: 'Six VLANs behind one default-deny firewall, a rebuilt forest, a scanner with a least-privilege identity, a SIEM with its own rules, and every decision written down.' },
];
---

<Base title={title} description={description}>
  <section class="journey" id="journey">
    <div class="j-stage">
      <canvas class="j-canvas" aria-hidden="true"></canvas>

      <div class="j-copy">
        {scenes.map((s) => (
          <div class="j-panel" data-from={s.from} data-to={s.to}>
            <span class="j-kicker">{s.n} · {s.k}</span>
            <h2 class="j-h">{s.h}</h2>
            <p class="j-p">{s.p}</p>
            {s.n === '05' && (
              <div class="j-stats">
                <div><b data-count="39322" data-from="0.66">0</b><span>events decoded</span></div>
                <div><b data-count="1963" data-from="0.68">0</b><span>alerts, about 5%</span></div>
                <div><b data-count="100" data-from="0.70" data-suffix="%">0</b><span>kept in the archive</span></div>
              </div>
            )}
            {s.n === '06' && (
              <div class="j-stats">
                <div><b data-count="6" data-from="0.82">0</b><span>VLANs</span></div>
                <div><b data-count="4" data-from="0.83">0</b><span>Wazuh agents</span></div>
                <div><b data-count="21" data-from="0.84">0</b><span>runbooks</span></div>
              </div>
            )}
          </div>
        ))}
        <div class="j-panel j-end" data-from="0.93" data-to="1.5">
          <span class="j-kicker">The work behind it</span>
          <h2 class="j-h">Every step above is real, and written up.</h2>
          <div class="actions">
            <a class="btn" href="/work/enterprise-security-homelab/">Read the case study</a>
            <a class="btn btn-ghost" href="/writing/">The lab notes</a>
          </div>
        </div>
      </div>

      <a class="j-skip" href="/work/">Skip to the work ↗</a>
      <div class="j-hint" aria-hidden="true">Scroll</div>
    </div>
  </section>

  <noscript>
    <div class="container" style="padding:4rem 0">
      <h1 class="display h2">The sign-in journey</h1>
      <p>This page is a scroll-driven 3D walk through the lab and needs JavaScript. The same story, in words and screenshots, is in the <a href="/work/enterprise-security-homelab/">homelab case study</a>.</p>
    </div>
  </noscript>

  <script>
    import { startJourney } from '../../scripts/journey';
    const root = document.getElementById('journey')!;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const gl = (() => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } })();
    if (still || !gl) {
      root.classList.add('is-static');
    } else {
      startJourney(root);
    }
  </script>
</Base>

<style is:global>
  .journey { position: relative; height: 900vh; }
  .j-stage { position: sticky; top: 0; height: 100vh; overflow: hidden; }
  .j-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .j-copy { position: absolute; inset: 0; pointer-events: none; }
  .j-panel {
    position: absolute; left: max(1rem, calc((100vw - var(--wide)) / 2 + 1rem)); top: 50%; transform: translateY(-50%);
    width: min(34rem, calc(100vw - 2rem)); opacity: 0; visibility: hidden; pointer-events: none;
    will-change: opacity, transform;
  }
  .j-panel .actions, .j-panel a { pointer-events: auto; }
  .j-kicker { display: block; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.9rem; }
  .j-h { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.2rem, 5.2vw, 4.2rem); line-height: 1.02; letter-spacing: -0.03em; color: var(--ink); margin: 0 0 1rem; }
  .j-p { font-size: clamp(1rem, 1.35vw, 1.2rem); line-height: 1.55; color: var(--ink-2); max-width: 30rem; margin: 0; }
  .j-stats { display: flex; gap: 2rem; margin-top: 1.6rem; flex-wrap: wrap; }
  .j-stats b { display: block; font-family: var(--font-display); font-weight: 800; font-size: clamp(1.8rem, 3.6vw, 2.8rem); letter-spacing: -0.03em; color: var(--ink); line-height: 1; }
  .j-stats span { display: block; font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); margin-top: 0.4rem; }
  .j-end .actions { margin-top: 1.4rem; display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .j-skip { position: absolute; right: 1.25rem; bottom: 1.25rem; font-size: 0.8rem; padding: 0.5rem 0.85rem; border-radius: 999px; border: 1px solid var(--line-2); background: color-mix(in srgb, var(--paper) 80%, transparent); color: var(--ink-2); text-decoration: none; backdrop-filter: blur(8px); }
  .j-skip:hover { color: var(--ink); border-color: var(--accent-line); }
  .j-hint { position: absolute; left: 50%; bottom: 1.4rem; transform: translateX(-50%); font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--ink-3); animation: j-bob 2.2s ease-in-out infinite; }
  @keyframes j-bob { 0%, 100% { transform: translate(-50%, 0); } 50% { transform: translate(-50%, 6px); } }

  /* No motion, or no WebGL: the copy stacks as plain sections. */
  .journey.is-static { height: auto; }
  .journey.is-static .j-stage { position: static; height: auto; overflow: visible; }
  .journey.is-static .j-canvas, .journey.is-static .j-hint { display: none; }
  .journey.is-static .j-copy { position: static; pointer-events: auto; }
  .journey.is-static .j-panel { position: static; transform: none; opacity: 1 !important; visibility: visible !important; width: auto; max-width: var(--measure); margin: 0 auto; padding: 4rem 1rem; }
  .journey.is-static .j-skip { position: static; display: inline-block; margin: 0 auto 3rem; }

  @media (max-width: 720px) {
    .j-panel { top: auto; bottom: 4.5rem; transform: none; }
    .j-p { font-size: 0.95rem; }
    .j-stats { gap: 1.2rem; }
  }
</style>
