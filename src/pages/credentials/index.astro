---
import Base from '../../layouts/Base.astro';
import { CERTS, RUNWAY, GOALS, DOMAIN_LABELS, type CertDomain } from '../../data/certifications';

const domains = Object.keys(DOMAIN_LABELS) as CertDomain[];
const count = (d: CertDomain) => CERTS.filter((c) => c.domain === d).length;
---

<Base title="Credentials" description="Noble Antwi's certifications with verification links: AWS Security Specialty, CCSP, Microsoft SC-300, Okta Certified Professional and Administrator, CompTIA Security+, KCNA, and more.">
  <div class="container">
    <header class="page-head">
      <span class="kicker">Credentials</span>
      <h1 class="display h1">Seventeen credentials, weighted toward identity and cloud security.</h1>
      <p class="lead">Every badge links to its issuer for verification. The identity and cloud security ones are the core of what I do; the rest are the foundation under it. The courses behind them are on the <a href="/credentials/training/">training page</a>.</p>
    </header>

    <div class="stat-strip" style="margin-bottom:2.5rem;">
      <div><strong>{CERTS.length}</strong><span>Active credentials</span></div>
      <div><strong>{count('identity')}</strong><span>Identity-focused</span></div>
      <div><strong>{CERTS.filter((c) => c.issuer === 'Amazon Web Services').length}</strong><span>AWS certifications</span></div>
      <div><strong>{RUNWAY.length}</strong><span>On the runway</span></div>
    </div>

    <div class="filter-tabs" data-filter-group="cert" role="group" aria-label="Filter certifications">
      <button class="filter-tab is-active" data-filter="all" aria-pressed="true">All <span class="count">{CERTS.length}</span></button>
      {domains.map((d) => <button class="filter-tab" data-filter={d} aria-pressed="false">{DOMAIN_LABELS[d]} <span class="count">{count(d)}</span></button>)}
    </div>

    <div class="cert-grid">
      {CERTS.map((c) => (
        <div class={`cert-card${c.featured ? ' is-featured' : ''}`} data-filter-item data-filter-group="cert" data-cat={c.domain}>
          <div class="cert-head">
            <div class="cert-badge">
              {c.image ? <img src={c.image} alt={`${c.title} badge`} loading="lazy" referrerpolicy="no-referrer" width="58" height="58" /> : <span class="mark" aria-hidden="true">{c.mark}</span>}
            </div>
            <div>
              <div class="cert-issuer">{c.issuer}</div>
              <h3>{c.title}</h3>
            </div>
          </div>
          <p>{c.blurb}</p>
          {(c.issued || c.expires || c.credential) && (
            <div class="cert-meta">
              {c.issued && <span>{c.issued.startsWith('Renewed') ? c.issued : `Issued ${c.issued}`}</span>}
              {c.expires && <span>Expires {c.expires}</span>}
              {c.credential && <span>{c.credential}</span>}
            </div>
          )}
          <div class="cert-actions">
            <a href={c.verify} target="_blank" rel="noopener">{c.verifyLabel} ↗</a>
            {c.studyLog && <a href={c.studyLog}>Study log</a>}
          </div>
        </div>
      ))}
    </div>
    <p class="filter-empty" data-filter-group="cert">Nothing in this group.</p>

    <section class="section" id="in-progress">
      <div class="section-head">
        <div>
          <span class="kicker">On the runway</span>
          <h2 class="display h2">Exam prep in flight.</h2>
          <p>Progress is the prep course, not the exam.</p>
        </div>
        <a class="section-link" href="/credentials/training/">All training</a>
      </div>
      <div class="cert-grid">
        {RUNWAY.map((r) => (
          <div class="cert-card">
            <div class="cert-head">
              <div class="cert-badge"><span class="mark" aria-hidden="true">{r.mark}</span></div>
              <div><div class="cert-issuer">{r.issuer}</div><h3>{r.title}</h3></div>
            </div>
            <p>{r.blurb}</p>
            <div class="progress-row">
              <div class="progress-label"><span>{r.progressLabel}</span><b>{r.progress}%</b></div>
              <div class="bar"><div class={`bar-fill ${r.progress >= 80 ? 'is-ok' : 'is-warn'}`} style={`width:${r.progress}%`}></div></div>
            </div>
            {r.link && <div class="cert-actions"><a href={r.link.href}>{r.link.label}</a></div>}
          </div>
        ))}
      </div>
    </section>

    <section class="section" id="goals">
      <div class="section-head">
        <div>
          <span class="kicker">Further out</span>
          <h2 class="display h2">Where the path points after the runway clears.</h2>
        </div>
      </div>
      <div class="goal-grid">
        {GOALS.map((g) => <div class="goal"><b>{g.title}</b>{g.blurb}</div>)}
      </div>
    </section>
  </div>
</Base>
