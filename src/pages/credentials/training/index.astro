---
import Base from '../../../layouts/Base.astro';
import { COURSES, type CourseState } from '../../../data/courses';

const groups: { state: CourseState; title: string; blurb: string }[] = [
  { state: 'done', title: 'Completed', blurb: 'Professional certificates and courses with a credential to show for them.' },
  { state: 'active', title: 'In progress', blurb: 'Ordered by how far along I am.' },
  { state: 'planned', title: 'Queued', blurb: 'Bought or bookmarked, not started.' },
];
const by = (s: CourseState) => COURSES.filter((c) => c.state === s).sort((a, b) => (b.progress ?? 0) - (a.progress ?? 0));
---

<Base title="Training & courses" description="Courses and professional certificates Noble Antwi has completed, is working through, or has queued: Azure, SOC operations, detection engineering, Kubernetes, Terraform, and more.">
  <div class="container">
    <header class="page-head">
      <span class="kicker">Training</span>
      <h1 class="display h1">The study behind the credentials.</h1>
      <p class="lead">Completed programs first, then what I am actively working through, then the queue. Back to <a href="/credentials/">credentials</a>.</p>
    </header>

    <div class="filter-tabs" data-filter-group="course" role="group" aria-label="Filter courses">
      <button class="filter-tab is-active" data-filter="all" aria-pressed="true">All <span class="count">{COURSES.length}</span></button>
      {groups.map((g) => <button class="filter-tab" data-filter={g.state} aria-pressed="false">{g.title} <span class="count">{by(g.state).length}</span></button>)}
    </div>

    {groups.map((g) => (
      <section class="section" style="padding-top:1.5rem;">
        <div class="section-head">
          <div>
            <h2 class="display h2">{g.title}</h2>
            <p>{g.blurb}</p>
          </div>
        </div>
        <div class="course-list">
          {by(g.state).map((c) => (
            <div class="course-row" data-filter-item data-filter-group="course" data-cat={c.state}>
              <div>
                <h3>{c.title}</h3>
                <div class="meta"><b>{c.platform}</b>{c.instructor ? ` · ${c.instructor}` : ''}{c.note ? ` · ${c.note}` : ''}</div>
              </div>
              {c.progress !== undefined ? (
                <div class="progress"><div class="bar"><div class={`bar-fill ${c.progress === 100 ? 'is-ok' : c.progress >= 50 ? '' : 'is-warn'}`} style={`width:${c.progress}%`}></div></div>{c.progress}%</div>
              ) : <div></div>}
              {c.link ? <a href={c.link} target="_blank" rel="noopener">{c.linkLabel} ↗</a> : <span class="pill pill-plain">{c.state === 'planned' ? 'Not started' : c.progress && c.progress >= 80 ? 'Nearly done' : 'Active'}</span>}
            </div>
          ))}
        </div>
      </section>
    ))}
    <p class="filter-empty" data-filter-group="course">Nothing in this group.</p>
  </div>
</Base>
