---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { byDateDesc, SERIES, categoryLabel, postUrl, formatDate } from '../../lib/site';
import { getArticles } from '../../lib/medium';

const posts = (await getCollection('posts')).sort(byDateDesc);
const ARTICLES = await getArticles();
const series = SERIES.map((s) => ({ ...s, posts: posts.filter(s.match) })).filter((s) => s.posts.length > 0);
const caseFiles = posts.filter((p) => p.data.casefile);
const categories = [...new Set(posts.map((p) => p.data.category))];
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))].sort((a, b) => b - a);
---

<Base title="Writing" description="Lab notes from the homelab and IAM builds, certification study logs, and published articles on AWS security, identity, and threat analysis.">
  <div class="container">
    <header class="page-head">
      <span class="kicker">Writing</span>
      <h1 class="display h1">Lab notes, study logs, and the occasional long read.</h1>
      <p class="lead">{posts.length} journal entries written as I go, plus {ARTICLES.length} edited articles on Medium and AWS in Plain English. <a href="/feed.xml">RSS</a> if you prefer a reader.</p>
    </header>

    {caseFiles.length > 0 && (
      <section class="section case-files" style="padding-top:0;">
        <div class="section-head">
          <div>
            <span class="kicker">Case files</span>
            <h2 class="display h2">Real incidents, link by link.</h2>
            <p>A public breach report read in plain words: what happened at each step, the control that could have stopped it, and where that control stands in my lab.</p>
          </div>
        </div>
        <div class="cf-cards">
          {caseFiles.map((p) => (
            <a class="cf-card" href={postUrl(p)}>
              <span class="cf-k">Case file · {formatDate(p.data.date)}{p.data.read_time ? ` · ${p.data.read_time} min, with a replay` : ''}</span>
              <h3>{p.data.title}</h3>
              {p.data.description && <p>{p.data.description}</p>}
              <span class="cf-go">Open the case file →</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="section" style="padding-top:0;">
      <div class="section-head">
        <div>
          <span class="kicker">Series</span>
          <h2 class="display h2">Read in order.</h2>
        </div>
      </div>
      <div class="series-grid">
        {series.map((s) => (
          <a class="series-card" href={`/writing/?posts=${s.id}#journal`}>
            <h3>{s.title}</h3>
            <p>{s.blurb}</p>
            <span class="count">{s.posts.length} {s.posts.length === 1 ? 'entry' : 'entries'} · {s.posts[s.posts.length - 1].data.date.getUTCFullYear()}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section" id="journal">
      <div class="section-head">
        <div>
          <span class="kicker">Journal</span>
          <h2 class="display h2">Everything, newest first.</h2>
        </div>
      </div>
      <div class="filter-tabs" data-filter-group="posts" role="group" aria-label="Filter posts">
        <button class="filter-tab is-active" data-filter="all" aria-pressed="true">All <span class="count">{posts.length}</span></button>
        {categories.map((c) => (
          <button class="filter-tab" data-filter={c} aria-pressed="false">{categoryLabel(c)} <span class="count">{posts.filter((p) => p.data.category === c).length}</span></button>
        ))}
        {series.map((s) => (
          <button class="filter-tab" data-filter={s.id} aria-pressed="false">{s.title} <span class="count">{s.posts.length}</span></button>
        ))}
      </div>
      {years.map((y) => (
        <>
          <h3 class="year-label display">{y}</h3>
          <PostList posts={posts.filter((p) => p.data.date.getUTCFullYear() === y)} filterGroup="posts" />
        </>
      ))}
      <p class="filter-empty" data-filter-group="posts">No posts in this group yet.</p>
    </section>

    <section class="section" id="articles">
      <div class="section-head">
        <div>
          <span class="kicker">Published articles</span>
          <h2 class="display h2">Longer, edited pieces.</h2>
        </div>
        <a class="section-link" href="https://medium.com/@noble-antwi" target="_blank" rel="noopener">Medium profile</a>
      </div>
      <div class="filter-tabs" data-filter-group="articles" role="group" aria-label="Filter articles">
        <button class="filter-tab is-active" data-filter="all" aria-pressed="true">All <span class="count">{ARTICLES.length}</span></button>
        <button class="filter-tab" data-filter="aws" aria-pressed="false">AWS &amp; cloud <span class="count">{ARTICLES.filter((a) => a.cat === 'aws').length}</span></button>
        <button class="filter-tab" data-filter="threat" aria-pressed="false">Threat analysis <span class="count">{ARTICLES.filter((a) => a.cat === 'threat').length}</span></button>
      </div>
      <div class="article-list">
        {ARTICLES.map((a) => (
          <a class="article-row" href={a.href} target="_blank" rel="noopener" data-filter-item data-filter-group="articles" data-cat={a.cat}>
            <div>
              <h3>{a.title}</h3>
              <div class="meta"><b>{a.outlet}</b> · {a.date} · {a.topics}</div>
            </div>
            <span class="go">Read ↗</span>
          </a>
        ))}
      </div>
      <p class="filter-empty" data-filter-group="articles">No articles in this group.</p>
    </section>
  </div>
</Base>

<style>
  .case-files .section-head p { max-width: 40rem; }
  .cf-cards { display: grid; gap: 1rem; }
  .cf-card { display: block; padding: 1.6rem 1.7rem 1.5rem; border-radius: var(--radius); background: radial-gradient(120% 140% at 100% 0%, rgba(248, 113, 113, 0.18), transparent 55%), #0b1220; border: 1px solid #1e293b; color: #e2e8f0; text-decoration: none; box-shadow: 0 30px 60px -40px rgba(2, 6, 23, 0.7); transition: border-color 0.2s, transform 0.2s; }
  .cf-card:hover { border-color: #f87171; transform: translateY(-2px); }
  .cf-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .cf-k { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; color: #f87171; }
  .cf-card h3 { margin: 0.6rem 0 0; font-family: var(--font-display); font-size: clamp(1.35rem, 2.6vw, 1.9rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; color: #f8fafc; }
  .cf-card p { margin: 0.7rem 0 0; color: #cbd5e1; max-width: 46rem; line-height: 1.6; }
  .cf-go { display: inline-block; margin-top: 1rem; font-family: var(--font-mono); font-size: 0.78rem; color: #f87171; }
  @media (prefers-reduced-motion: reduce) { .cf-card { transition: none; } .cf-card:hover { transform: none; } }
</style>
