---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="That page does not exist.">
  <div class="container">
    <header class="page-head">
      <span class="kicker">404</span>
      <h1 class="display h1">Nothing at this address.</h1>
      <p class="lead">The page may have moved when the site was rebuilt. Try <a href="/work/">work</a>, <a href="/writing/">writing</a> or <a href="/credentials/">credentials</a>, or head <a href="/">home</a>.</p>
    </header>
  </div>
</Base>
