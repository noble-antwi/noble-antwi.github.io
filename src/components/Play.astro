---
/* The play layer, on every page: a simulated terminal (header >_ button or
   the backtick key) and the containment game. Any element with
   data-play="term" | "breach" | "vault" opens one of them. The game's
   Three.js code loads only when someone starts it. */
const CHIPS = ['Start-Containment', 'Unlock-BreakGlass', 'Get-WhatYourBrowserKnows', 'Get-Lab', 'Get-Alerts', 'Decode-Token', 'whoami', 'help'];
---

<div class="term" data-term hidden role="dialog" aria-modal="true" aria-label="Simulated terminal">
  <div class="t-head">
    <span><i class="t-dot"></i>PowerShell 7 <span class="t-dim">visitor@nobleantwi.com · simulated, nothing leaves your browser</span></span>
    <button type="button" class="t-x" data-t-close>Close · Esc</button>
  </div>
  <div class="t-out" data-t-out aria-live="polite"></div>
  <label class="t-row"><span class="t-p" data-t-prompt>PS C:\visitor&gt;</span><input data-t-in type="text" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Command" placeholder="type help" /></label>
  <div class="t-chips">{CHIPS.map((c, i) => <button type="button" class:list={['t-chip', { 'is-hot': i === 0 }]} data-t-cmd={c}>{c}</button>)}</div>
</div>

<div class="breach" data-breach hidden role="dialog" aria-modal="true" aria-label="Contain the breach, a mini game">
  <canvas aria-hidden="true"></canvas>
  <div class="b-hud">
    <div class="b-box"><span class="b-lab">Time</span><b data-b-time>60</b></div>
    <div class="b-box b-inf"><span class="b-lab">Infected</span><span class="b-bar"><i data-b-bar></i></span><small data-b-inf>0 of 25 before a breach</small></div>
    <div class="b-box b-right"><span class="b-lab">Score · level <span data-b-level>1</span></span><b data-b-score>0</b><small class="b-dc" data-b-dc>DC01 · clean</small></div>
  </div>
  <div class="b-count" data-b-count aria-live="assertive"></div>
  <div class="b-toast" data-b-toast aria-live="polite"></div>
  <div class="b-foot">
    <button type="button" class="b-seal" data-b-seal><span>Seal segment</span><kbd>Space</kbd></button>
    <button type="button" class="b-exit" data-b-close><span>Exit</span><kbd>Esc</kbd></button>
  </div>

  <div class="b-card" data-b-intro>
    <span class="b-kick">Mini game · 60 seconds · gets harder as you score</span>
    <h2>Contain the <b>breach.</b></h2>
    <p>A phishing link was clicked on a workstation in VLAN 50, and the attacker is moving sideways through the bank.</p>
    <ul>
      <li><i class="d-r"></i><span><b>Click a red host</b> to isolate it, the way EDR contains a machine. Quick isolations build a combo.</span></li>
      <li><i class="d-t"></i><span><b>Press Space</b> to seal the segment you last clicked at pfSense for 12 seconds. Nothing crosses in or out. It recharges, slower as the levels rise.</span></li>
      <li><i class="d-g"></i><span><b>Protect DC01.</b> If the infection reaches the domain controller, it is over. So is 25 infected machines at once.</span></li>
      <li><i class="d-s"></i><span>Isolating a clean host costs 50 points. Isolated hosts rejoin after 14 seconds. From level 3, phishing waves land.</span></li>
    </ul>
    <div class="b-actions"><button type="button" class="btn" data-b-start>Start</button><button type="button" class="btn btn-ghost" data-b-close>Not now</button></div>
  </div>

  <div class="b-card b-end" data-b-end hidden>
    <span class="b-kick" data-b-kicker>Breach</span>
    <h2 data-b-title>That's a <b>breach.</b></h2>
    <p data-b-why></p>
    <div class="b-stats"><div><b data-b-s-score>0</b><span>score</span></div><div><b data-b-s-iso>0</b><span>isolated</span></div><div><b data-b-s-clean>0%</b><span>estate clean</span></div></div>
    <p class="b-best">Your best on this device: <b data-b-best>0</b></p>
    <div class="b-actions"><button type="button" class="btn" data-b-again>Play again</button><button type="button" class="btn btn-ghost" data-b-close>Back to the site</button></div>
  </div>
</div>

<script>
  import { initTerminal } from '../scripts/terminal';
  const html = document.documentElement;
  const termEl = document.querySelector<HTMLElement>('[data-term]')!;
  const breachEl = document.querySelector<HTMLElement>('[data-breach]')!;
  let loading = false;
  async function startBreach() {
    term.close();
    if (loading || !breachEl.hidden) return;
    const gl = (() => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } })();
    if (!gl) { term.open(); return; }
    loading = true;
    try { const { openBreach } = await import('../scripts/breach'); openBreach(breachEl); } finally { loading = false; }
  }
  const term = initTerminal(termEl, { startBreach });
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-play]');
    if (!t) return;
    e.preventDefault();
    const what = t.dataset.play;
    if (what === 'breach') startBreach();
    else if (what === 'vault') term.open('Unlock-BreakGlass');
    else term.isOpen() ? term.close() : term.open();
  });
  document.addEventListener('keydown', (e) => {
    const el = e.target as HTMLElement;
    if (e.key !== '`' || el.closest('input, textarea, [contenteditable]') || html.classList.contains('breach-open')) return;
    e.preventDefault(); term.isOpen() ? term.close() : term.open();
  });
</script>

<style is:global>
  .term { position: fixed; left: 0; right: 0; top: 0; z-index: 75; height: min(64vh, 34rem); display: flex; flex-direction: column; background: #0b1220; color: #cbd5e1; border-bottom: 1px solid #1e293b; box-shadow: 0 30px 80px rgba(2, 6, 23, 0.55); font-family: var(--font-mono); font-size: 0.82rem; animation: t-drop 0.28s ease; }
  .term[hidden] { display: none; }
  @keyframes t-drop { from { transform: translateY(-24px); opacity: 0; } }
  .t-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.7rem 1.25rem; border-bottom: 1px solid #1e293b; color: #e2e8f0; font-size: 0.74rem; }
  .t-dot { display: inline-block; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #2dd4bf; margin-right: 0.6rem; box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.18); }
  .t-x { background: none; border: 1px solid #334155; color: #cbd5e1; border-radius: 6px; padding: 0.3rem 0.6rem; font: inherit; cursor: pointer; }
  .t-x:hover { border-color: #2dd4bf; color: #fff; }
  .t-out { flex: 1; overflow-y: auto; padding: 1rem 1.25rem 0.4rem; line-height: 1.6; }
  .t-line { margin: 0 0 0.45rem; white-space: normal; overflow-wrap: anywhere; }
  .t-line a { color: #5eead4; }
  .t-echo { color: #e2e8f0; margin-top: 0.6rem; }
  .t-p { color: #5eead4; white-space: nowrap; }
  .t-dim { color: #64748b; }
  .t-k { color: #64748b; white-space: pre; }
  .t-ok { color: #4ade80; }
  .t-bad { color: #fda4af; }
  .t-red { color: #fb7185; }
  .t-vio { color: #c4b5fd; }
  .t-lvl { display: inline-block; min-width: 2.6rem; font-weight: 700; }
  .t-lvl-hi { color: #fb7185; } .t-lvl-md { color: #fbbf24; } .t-lvl-lo { color: #64748b; }
  .t-row { display: flex; align-items: center; gap: 0.6rem; padding: 0.55rem 1.25rem; border-top: 1px solid #1e293b; }
  .t-row input { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; color: #f8fafc; font: inherit; caret-color: #2dd4bf; }
  .t-chips { display: flex; gap: 0.45rem; padding: 0.6rem 1.25rem 0.8rem; overflow-x: auto; scrollbar-width: none; }
  .t-chip { flex: none; background: #111a2e; border: 1px solid #263248; color: #cbd5e1; border-radius: 999px; padding: 0.35rem 0.75rem; font: inherit; font-size: 0.72rem; cursor: pointer; }
  .t-chip:hover { border-color: #2dd4bf; color: #fff; }
  .t-chip.is-hot { background: #2dd4bf; border-color: #2dd4bf; color: #04201c; font-weight: 700; }
  .t-vault { background: #1d3b8f; color: #e0e7ff; border-radius: 10px; padding: 1rem 1.1rem; max-width: 34rem; box-shadow: 0 10px 30px rgba(29, 59, 143, 0.35); }
  .t-vault strong { display: block; font-family: var(--font-display); font-size: 1.05rem; margin-bottom: 0.3rem; color: #fff; }
  .t-vault p { margin: 0 0 0.7rem; color: #c7d2fe; }
  .t-slots { display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; margin-bottom: 0.7rem; }
  .t-slots i { color: #a5b4fc; font-style: normal; }
  .t-slot { background: #142c6e; border: 1px solid #3b5bc7; border-radius: 6px; padding: 0.25rem 0.6rem; letter-spacing: 0.12em; color: #a5b4fc; }
  .t-slot.is-ok { color: #fff; border-color: #4ade80; background: #14532d; }
  .t-vault ol { list-style: none; margin: 0 0 0.6rem; padding: 0; display: grid; gap: 0.3rem; }
  .t-vault li b { display: inline-block; width: 1.4rem; color: #fff; }
  .t-vault li.is-ok { color: #86efac; text-decoration: line-through; text-decoration-color: rgba(134, 239, 172, 0.5); }
  .t-vault small { color: #a5b4fc; }
  .t-alert { border-left: 3px solid #fbbf24; background: #1a1608; padding: 0.7rem 0.9rem; border-radius: 0 8px 8px 0; color: #fde68a; max-width: 34rem; }
  .t-alert span { display: block; font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: #a16207; margin-bottom: 0.3rem; }
  .t-alert em { display: block; margin-top: 0.4rem; color: #cbd5e1; font-style: normal; }

  html.breach-open, html.breach-open body { overflow: hidden; }
  .breach { position: fixed; inset: 0; z-index: 80; background: #060b16; color: #e2e8f0; font-family: var(--font-sans); }
  .breach[hidden] { display: none; }
  .breach canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: manipulation; cursor: crosshair; }
  .b-hud { position: absolute; top: 1rem; left: 50%; transform: translateX(-50%); width: min(46rem, calc(100% - 2rem)); display: grid; grid-template-columns: auto 1fr auto; gap: 1.2rem; align-items: center; background: rgba(6, 11, 22, 0.72); border: 1px solid #1e293b; border-radius: 12px; padding: 0.7rem 1rem; pointer-events: none; }
  .b-lab { display: block; font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; color: #64748b; margin-bottom: 0.2rem; }
  .b-box b { font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; color: #f8fafc; line-height: 1; }
  .b-box small { display: block; font-family: var(--font-mono); font-size: 0.66rem; color: #94a3b8; margin-top: 0.3rem; }
  .b-bar { display: block; height: 6px; border-radius: 4px; background: #1e293b; overflow: hidden; }
  .b-bar i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #f59e0b, #ef4444); transition: width 0.2s ease; }
  .b-right { text-align: right; }
  .b-dc { color: #fbbf24 !important; }
  .b-dc.is-bad { color: #fb7185 !important; animation: b-blink 0.8s steps(2) infinite; }
  @keyframes b-blink { 50% { opacity: 0.35; } }
  .b-count { position: absolute; left: 50%; top: 45%; transform: translate(-50%, -50%) scale(0.8); font-family: var(--font-display); font-weight: 800; font-size: clamp(4rem, 14vw, 9rem); color: rgba(248, 250, 252, 0.85); opacity: 0; pointer-events: none; transition: opacity 0.2s, transform 0.2s; }
  .b-count.is-on { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  .b-toast { position: absolute; left: 50%; top: 6.6rem; transform: translateX(-50%) translateY(-6px); font-family: var(--font-mono); font-size: 0.76rem; padding: 0.4rem 0.8rem; border-radius: 999px; background: #0f172a; border: 1px solid #334155; color: #e2e8f0; opacity: 0; transition: opacity 0.2s, transform 0.2s; pointer-events: none; white-space: nowrap; }
  .b-toast.is-on { opacity: 1; transform: translateX(-50%); }
  .b-toast.is-bad { border-color: #be123c; color: #fda4af; }
  .b-toast.is-up { border-color: #0f766e; color: #5eead4; }
  .b-foot { position: absolute; left: 50%; bottom: 1.2rem; transform: translateX(-50%); display: flex; gap: 0.6rem; }
  .b-foot button { white-space: nowrap; display: inline-flex; align-items: center; gap: 0.5rem; background: #0f172a; border: 1px solid #334155; color: #e2e8f0; border-radius: 999px; padding: 0.5rem 0.9rem; font: 600 0.82rem var(--font-sans); cursor: pointer; }
  .b-foot kbd { font-family: var(--font-mono); font-size: 0.66rem; border: 1px solid #334155; border-radius: 4px; padding: 0.05rem 0.35rem; color: #94a3b8; }
  .b-seal { position: relative; overflow: hidden; --k: 1; }
  .b-seal::before { content: ''; position: absolute; inset: 0; background: rgba(45, 212, 191, 0.22); transform-origin: left; transform: scaleX(var(--k)); }
  .b-seal span, .b-seal kbd { position: relative; }
  .b-seal.is-ready { border-color: #2dd4bf; color: #5eead4; }
  .b-card { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(30rem, calc(100% - 2rem)); background: rgba(8, 13, 26, 0.94); border: 1px solid #1e293b; border-radius: 16px; padding: 1.6rem 1.6rem 1.4rem; box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55); }
  .b-card[hidden] { display: none; }
  .b-kick { display: block; font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.18em; text-transform: uppercase; color: #5eead4; margin-bottom: 0.7rem; }
  .b-end .b-kick { color: #fb7185; }
  .b-end.is-win .b-kick { color: #4ade80; }
  .b-card h2 { font-family: var(--font-display); font-weight: 400; font-size: clamp(1.9rem, 4vw, 2.5rem); line-height: 1.05; letter-spacing: -0.02em; margin: 0 0 0.8rem; color: #f8fafc; }
  .b-card h2 b { font-weight: 800; }
  .b-card p { color: #cbd5e1; font-size: 0.92rem; line-height: 1.55; margin: 0 0 0.9rem; }
  .b-card ul { list-style: none; padding: 0; margin: 0 0 1.2rem; display: grid; gap: 0.6rem; font-size: 0.86rem; color: #cbd5e1; line-height: 1.45; }
  .b-card li { display: flex; gap: 0.65rem; }
  .b-card li i { flex: none; width: 0.5rem; height: 0.5rem; border-radius: 50%; margin-top: 0.42rem; }
  .b-card li b { color: #f8fafc; }
  .d-r { background: #ef4444; } .d-t { background: #2dd4bf; } .d-g { background: #fbbf24; } .d-s { background: #64748b; }
  .b-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .breach .btn { background: #2dd4bf; border: 1px solid #2dd4bf; color: #04201c; }
  .breach .btn-ghost { background: transparent; border-color: #334155; color: #e2e8f0; }
  .breach .btn-ghost:hover { border-color: #94a3b8; color: #fff; }
  .b-stats { display: flex; gap: 2rem; margin: 0.4rem 0 0.9rem; }
  .b-stats b { display: block; font-family: var(--font-display); font-weight: 800; font-size: 1.6rem; color: #f8fafc; }
  .b-stats span { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: #64748b; }
  .b-best { font-family: var(--font-mono); font-size: 0.74rem !important; color: #94a3b8 !important; }
  .b-best b { color: #5eead4; }
  @media (max-width: 640px) {
    .b-hud { grid-template-columns: auto 1fr; gap: 0.6rem 1rem; top: 0.6rem; }
    .b-right { grid-column: 1 / -1; display: flex; align-items: baseline; gap: 0.8rem; text-align: left; }
    .b-right .b-lab { margin: 0; }
    .b-toast { top: 9rem; }
    .b-card { padding: 1.2rem; max-height: calc(100% - 2rem); overflow-y: auto; }
    .b-card ul { font-size: 0.8rem; }
    .b-foot { bottom: 0.8rem; }
    .b-foot button { font-size: 0.78rem; padding: 0.45rem 0.75rem; }
    .term { height: 78vh; font-size: 0.76rem; }
  }
</style>
