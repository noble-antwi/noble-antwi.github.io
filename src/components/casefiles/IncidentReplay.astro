      </svg>
    </div>
  </div>
  <p class="rp-hint" aria-hidden="true">Swipe the map sideways to see it all →</p>
  <figcaption class="rp-cap" data-rp-cap><b>29 Oct 2026</b> <span>{SCENES[0].note}</span></figcaption>
  <div class="rp-ctl" data-rp-ctl>
    <button type="button" class="rp-play" data-rp-play aria-label="Play the replay">Play</button>
    <input type="range" min="0" max={D} step="0.01" value="0" aria-label="Replay position" data-rp-seek />
  </div>
  <ol class="rp-chips" data-rp-chips>
    {SCENES.map((s, i) => <li><button type="button" data-at={s.at} aria-label={`Jump to ${s.chip}`}><span>{i}</span>{s.chip}</button></li>)}
  </ol>
  <script type="application/json" data-rp-scenes set:html={JSON.stringify(SCENES)} />
</figure>

<style>
  .rp { margin: 0; border-radius: var(--radius); overflow: hidden; background: #0b1220; border: 1px solid #1e293b; box-shadow: 0 30px 60px -40px rgba(2, 6, 23, 0.7); color: #e2e8f0; }
  .rp-bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.6rem 1rem; border-bottom: 1px solid #1e293b; font: 500 0.7rem var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: #94a3b8; }
  .rp-bar i { display: inline-block; width: 0.5rem; height: 0.5rem; margin-right: 0.55rem; border-radius: 50%; background: #f87171; box-shadow: 0 0 10px #f87171; vertical-align: 0.05em; }
  .rp-time { font-variant-numeric: tabular-nums; letter-spacing: 0.04em; }
  .rp-scroll { overflow-x: auto; scrollbar-width: thin; }
  .rp-stage { min-width: 700px; }
  @media (min-width: 761px) { .rp-stage { min-width: 0; } }
  .rp-hint { display: none; margin: 0; padding: 0.45rem 1.1rem; font: 0.7rem var(--font-mono); color: #f87171; border-top: 1px solid #1e293b; }
  @media (max-width: 760px) { .rp-hint { display: block; } }
  .rp-stage :global(svg) { display: block; width: 100%; height: auto; }
  .rp-stage :global(text) { font-family: var(--font-body); }
  .rp-stage :global(text:not([fill])) { fill: #e2e8f0; }
  .rp-stage :global(text.dim:not([fill])) { fill: #94a3b8; }
  .rp-stage :global(.vm) { font-family: var(--font-mono); }
  .rp-stage :global(.mv) { filter: drop-shadow(0 0 5px currentColor); }
  .rp-cap { margin: 0; padding: 0.9rem 1.1rem; border-top: 1px solid #1e293b; font-family: var(--font-body); font-size: 1rem; line-height: 1.55; color: #cbd5e1; min-height: 4.6em; }
  .rp-cap b { font-family: var(--font-mono); font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #f87171; margin-right: 0.4rem; }
  .rp-ctl { display: flex; align-items: center; gap: 0.9rem; padding: 0.2rem 1.1rem 0.7rem; }
  .rp-play { font: 600 0.72rem var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: #0b1220; background: #f87171; border: 0; border-radius: 999px; padding: 0.4rem 0.95rem; cursor: pointer; min-width: 5.2rem; }
  .rp-play:focus-visible, .rp-chips button:focus-visible, .rp-ctl input:focus-visible { outline: 2px solid #2dd4bf; outline-offset: 2px; }
  .rp-ctl input { flex: 1; accent-color: #f87171; min-width: 0; }
  .rp-chips { list-style: none; margin: 0; padding: 0 1.1rem 1rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .rp-chips button { font: 500 0.7rem var(--font-mono); letter-spacing: 0.04em; color: #94a3b8; background: transparent; border: 1px solid #334155; border-radius: 999px; padding: 0.25rem 0.65rem; cursor: pointer; }
  .rp-chips button span { color: #64748b; margin-right: 0.35rem; }
  .rp-chips button:hover { border-color: #f87171; color: #f1f5f9; }
  .rp-chips button[aria-current='step'] { border-color: #f87171; color: #f1f5f9; background: rgba(248, 113, 113, 0.14); }
</style>

<script>
  /* render(t) draws any moment of the replay; playback, seeking and the
     video export all go through it. */
  const fig = document.querySelector<HTMLElement>('[data-replay]');
  if (fig) {
    const D = Number(fig.dataset.d);
    const scenes: { at: number; when: string; note: string }[] = JSON.parse(fig.querySelector('[data-rp-scenes]')!.textContent || '[]');
    const fades = [...fig.querySelectorAll<SVGElement>('[data-on], [data-off]')].map((el) => ({
      el, on: Number(el.dataset.on ?? -1), off: Number(el.dataset.off ?? D + 1),
    }));
    const movers = [...fig.querySelectorAll<SVGCircleElement>('[data-path]')].map((el) => {
      const path = fig.querySelector<SVGPathElement>(`#${el.dataset.path}`)!;
      return { el, path, len: path.getTotalLength(), s: Number(el.dataset.s), e: Number(el.dataset.e) };
    });
    const whenEl = fig.querySelector('[data-rp-when]')!;
    const amtEl = fig.querySelector('[data-rp-amt]')!;
    const cap = fig.querySelector('[data-rp-cap]')!;
    const clock = fig.querySelector('[data-rp-clock]')!;
    const seek = fig.querySelector<HTMLInputElement>('[data-rp-seek]')!;
    const play = fig.querySelector<HTMLButtonElement>('[data-rp-play]')!;
    const chips = [...fig.querySelectorAll<HTMLButtonElement>('[data-rp-chips] button')];

    const clamp = (x: number) => Math.max(0, Math.min(1, x));
    const ease = (x: number) => x * x * (3 - 2 * x);
    const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    const hhmm = (m: number) => `${String(Math.floor(m / 60) % 24).padStart(2, '0')}:${String(Math.floor(m % 60)).padStart(2, '0')}`;
    let shown = -1;

    function render(t: number) {
      for (const f of fades) {
        const o = clamp((t - f.on) / 0.35) * clamp((f.off - t) / 0.35);
        f.el.style.opacity = String(o);
      }
      for (const m of movers) {
        if (t < m.s || t > m.e) { m.el.setAttribute('opacity', '0'); continue; }
        const p = ease((t - m.s) / (m.e - m.s));
        const pt = m.path.getPointAtLength(m.len * p);
        m.el.setAttribute('cx', String(pt.x));
        m.el.setAttribute('cy', String(pt.y));
        m.el.setAttribute('opacity', String(Math.min(1, (t - m.s) * 6, (m.e - t) * 6)));
      }
      /* the money: XRP first, then the rest, to Binance's $6.34B */
      const amt = 6.34 * ease(clamp((t - 34.4) / 5.2));
      amtEl.textContent = `$${amt.toFixed(2)}B`;
      let i = 0;
      while (i + 1 < scenes.length && t >= scenes[i + 1].at) i++;
      let when = scenes[i].when;
      if (i === 5 && t > 32) when = '29 Oct · 19:56 UTC';
      if (i === 6) when = `29 Oct · ${hhmm(20 * 60 + 5 + 4 * clamp((t - 34.4) / 3))} UTC`;
      if (i === 7) when = t < 45.4 ? '29 Oct · 20:09 UTC' : t < 46.5 ? '29 Oct · 23:56 UTC' : '30 Oct · 00:10 UTC';
      whenEl.textContent = when;
      if (i !== shown) {
        shown = i;
        cap.innerHTML = '';
        const b = document.createElement('b'); b.textContent = scenes[i].when;
        const s = document.createElement('span'); s.textContent = scenes[i].note;
        cap.append(b, ' ', s);
        chips.forEach((c, k) => { if (k === i) c.setAttribute('aria-current', 'step'); else c.removeAttribute('aria-current'); });
      }
      clock.textContent = `${mmss(t)} / ${mmss(D)}`;
      seek.value = String(t);
    }

    let t = 0;
    let playing = false;
    let last = 0;
    let seen = false;
    const label = () => { play.textContent = playing ? 'Pause' : t >= D ? 'Replay' : 'Play'; play.setAttribute('aria-label', `${play.textContent} the replay`); };
    const tick = (now: number) => {
      if (!playing) return;
      t = Math.min(D, t + (now - last) / 1000);
      last = now;
      render(t);
      if (t >= D) { playing = false; label(); return; }
      requestAnimationFrame(tick);
    };
    const start = () => { if (t >= D) t = 0; playing = true; last = performance.now(); label(); requestAnimationFrame(tick); };
    const stop = () => { playing = false; label(); };

    play.addEventListener('click', () => (playing ? stop() : start()));
    seek.addEventListener('input', () => { stop(); t = Number(seek.value); render(t); });
    chips.forEach((c) => c.addEventListener('click', () => { t = Number(c.dataset.at) + 0.01; render(t); if (!playing) start(); }));

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) { t = 51; render(t); label(); }
    else {
      render(0);
      new IntersectionObserver((es) => {
        const vis = es.some((e) => e.isIntersecting);
        if (vis && !seen) { seen = true; start(); }
        else if (!vis && playing) stop();
      }, { threshold: 0.45 }).observe(fig);
    }
    (window as unknown as { __incidentReplay: unknown }).__incidentReplay = { D, render: (x: number) => { stop(); t = x; render(x); } };
  }
</script>
