        <g data-on="24.6">
          <g transform="translate(366 92)"><circle cx="6" cy="6" r="5.5" fill="none" stroke={C.gold} stroke-width="2.2" /><path d="M10 10 l10 10 M16 16 l3 -3 M19 19 l2.5 -2.5" stroke={C.gold} stroke-width="2.2" stroke-linecap="round" /></g>
