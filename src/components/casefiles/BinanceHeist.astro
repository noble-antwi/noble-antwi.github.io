<script is:inline>
(function () {
  var stages = Array.prototype.slice.call(document.querySelectorAll('.cf .stage'));
  var n = stages.length;
  var track = document.getElementById('trackPath');
  var lit = document.getElementById('litPath');
  var nodesG = document.getElementById('nodes');
  var railDots = document.getElementById('railDots');
  var railNow = document.getElementById('railNow');
  var railLabel = document.getElementById('railLabel');
  var NS = 'http://www.w3.org/2000/svg';
  var total = track.getTotalLength();
  var nodes = [], labels = [], halos = [];

  lit.style.strokeDasharray = total;
  lit.style.strokeDashoffset = total;

  function el(tag, attrs) {
    var e = document.createElementNS(NS, tag);
    for (var k in attrs) e.setAttribute(k, attrs[k]);
    return e;
  }

  stages.forEach(function (s, i) {
    var p = track.getPointAtLength(total * i / (n - 1));
    var halo = el('circle', { 'class': 'halo', cx: p.x, cy: p.y, r: 9 });
    var node = el('circle', { 'class': 'node', cx: p.x, cy: p.y, r: 8 });
    var lbl = el('text', { 'class': 'lbl', x: p.x + 24, y: p.y - 2 });
    lbl.textContent = (i + 1) + ' · ' + s.dataset.short.toUpperCase();
    var sub = el('text', { 'class': 'sub', x: p.x + 24, y: p.y + 14 });
    sub.textContent = s.dataset.label;
    nodesG.appendChild(halo); nodesG.appendChild(node); nodesG.appendChild(lbl); nodesG.appendChild(sub);
    nodes.push(node); labels.push(lbl); halos.push(halo);

    if (i > 0) { var bar = document.createElement('i'); railDots.appendChild(bar); }
    var dot = document.createElement('b'); railDots.appendChild(dot);
  });

  var railBars = railDots.querySelectorAll('i');
  var railBalls = railDots.querySelectorAll('b');
  var current = -1;

  function setStage(i) {
    if (i === current) return;
    current = i;
    lit.style.strokeDashoffset = total * (1 - i / (n - 1));
    stages.forEach(function (s, k) { s.classList.toggle('now', k === i); });
    nodes.forEach(function (nd, k) { nd.classList.toggle('on', k <= i); nd.classList.toggle('now', k === i); });
    labels.forEach(function (l, k) { l.classList.toggle('on', k <= i); l.classList.toggle('now', k === i); });
    halos.forEach(function (h, k) { h.classList.toggle('now', k === i); });
    railBars.forEach(function (b, k) { b.classList.toggle('on', k < i); });
    railBalls.forEach(function (b, k) { b.classList.toggle('on', k <= i); b.classList.toggle('now', k === i); });
    railNow.textContent = (i + 1) + ' · ' + stages[i].dataset.short;
    railLabel.textContent = stages[i].dataset.label;
  }

  setStage(0);

  if ('IntersectionObserver' in window) {
    var ratios = stages.map(function () { return 0; });
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { ratios[stages.indexOf(e.target)] = e.intersectionRatio; });
      var best = 0;
      for (var k = 1; k < n; k++) if (ratios[k] > ratios[best] + 0.05) best = k;
      setStage(best);
