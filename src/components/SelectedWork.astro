---
/* Homepage "Selected work": the two flagship labs as large cards, then one
   compact card per remaining pillar. Each card wears its subject colour,
   the same colours the journey above uses. */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { WORK_CATEGORIES } from '../lib/site';

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const flagships = all.filter((w) => w.data.featured);
const PICKS = ['cloud-security-posture-dashboard', 'biirabank-web', 'collins-aerospace-it-audit', 'iam-job-scout'];
const compact = PICKS.map((id) => all.find((w) => w.id === id)).filter((w): w is (typeof all)[number] => !!w);
const counts = Object.keys(WORK_CATEGORIES).map((k) => ({ k, label: WORK_CATEGORIES[k], n: all.filter((w) => w.data.category === k).length }));
const WORDS = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve'];
const allLabel = `All ${(WORDS[all.length] ?? String(all.length)).toLowerCase()} projects`;
---

<section class="section sw" aria-labelledby="sw-h">
  <div class="sw-head">
    <div>
      <span class="kicker">Selected work</span>
      <h2 class="display h2" id="sw-h">Labs built like production, documented like an audit.</h2>
    </div>
    <div class="sw-pillars" aria-label="Projects by subject">
      {counts.map((c) => (
        <a class="sw-pill" href={`/work/?work=${c.k}`} style={`--c: var(--c-${c.k})`}>
          <i aria-hidden="true"></i>{c.label}<b>{c.n}</b>
        </a>
      ))}
    </div>
  </div>

  <div class="sw-flag">
    {flagships.map((w, i) => (
      <a class="sw-card sw-big" href={`/work/${w.id}/`} style={`--c: var(--c-${w.data.category}); --d: ${i * 90}ms`}>
        <div class="sw-media">
          {w.data.hero && <Image src={w.data.hero} alt={w.data.heroAlt ?? ''} width={1000} densities={[1, 1.5]} loading="lazy" />}
          <span class="sw-status">{w.data.statusLabel}</span>
        </div>
        <div class="sw-body">
          <span class="sw-kicker">{w.data.kicker}</span>
          <h3>{w.data.title}</h3>
          <p>{w.data.summary}</p>
          <dl class="sw-stats">
            {w.data.stats.slice(0, 4).map((s) => (
              <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
            ))}
          </dl>
          <span class="sw-go">Read the case study <span aria-hidden="true">→</span></span>
        </div>
      </a>
    ))}
  </div>

  <div class="sw-grid">
    {compact.map((w, i) => (
      <a class="sw-card sw-small" href={`/work/${w.id}/`} style={`--c: var(--c-${w.data.category}); --d: ${i * 70}ms`}>
        <div class="sw-media">
          {w.data.hero && <Image src={w.data.hero} alt={w.data.heroAlt ?? ''} width={560} densities={[1, 1.5]} loading="lazy" />}
        </div>
        <div class="sw-body">
          <span class="sw-kicker">{WORK_CATEGORIES[w.data.category]}</span>
          <h3>{w.data.title}</h3>
          <p>{w.data.summary}</p>
          <dl class="sw-stats">
            {w.data.stats.slice(0, 2).map((s) => (
              <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
            ))}
          </dl>
        </div>
      </a>
    ))}
  </div>

  <div class="sw-more">
    <a class="btn btn-ghost" href="/work/">{allLabel} <span aria-hidden="true">→</span></a>
  </div>
</section>

<style is:global>
  .sw-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .sw-head h2 { max-width: 34rem; margin-top: 0.4rem; }
  .sw-pillars { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .sw-pill { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.42rem 0.8rem; border-radius: 999px; border: 1px solid var(--line-2); font-size: 0.85rem; color: var(--ink-2); text-decoration: none; background: var(--paper); transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease; }
  .sw-pill i { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--c); }
  .sw-pill b { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; color: var(--ink-3); }
  .sw-pill:hover { border-color: var(--c); color: var(--ink); background: color-mix(in srgb, var(--c) 8%, var(--paper)); }

  .sw-card { position: relative; display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: var(--paper); color: inherit; text-decoration: none;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04); transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease; transition-delay: 0ms; }
  .sw-card::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 4px; background: var(--c); z-index: 2; }
  .sw-card:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--c) 55%, var(--line)); box-shadow: 0 18px 40px -18px color-mix(in srgb, var(--c) 45%, transparent); }
  .sw-card:focus-visible { outline: 3px solid var(--c); outline-offset: 3px; }
  .sw-card.reveal { transition-delay: var(--d, 0ms); }
  .sw-card.reveal.is-in { transition-delay: 0ms; }

  .sw-media { position: relative; background: var(--paper-2); border-bottom: 1px solid var(--line); overflow: hidden; }
  .sw-media img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform 0.6s ease; }
  .sw-card:hover .sw-media img { transform: scale(1.03); }
  .sw-big .sw-media { aspect-ratio: 16 / 9; }
  .sw-small .sw-media { aspect-ratio: 16 / 8; }
  .sw-status { position: absolute; left: 1rem; bottom: 1rem; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.35rem 0.65rem; border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 88%, transparent); color: var(--c); border: 1px solid color-mix(in srgb, var(--c) 40%, transparent); backdrop-filter: blur(6px); }

  .sw-body { display: flex; flex-direction: column; gap: 0.6rem; padding: 1.4rem 1.5rem 1.5rem; flex: 1; }
  .sw-kicker { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--c); }
  .sw-body h3 { font-family: var(--font-display); font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; margin: 0; color: var(--ink); }
  .sw-big h3 { font-size: clamp(1.4rem, 2.2vw, 1.75rem); }
  .sw-small h3 { font-size: 1.12rem; }
  .sw-body p { margin: 0; color: var(--ink-2); line-height: 1.55; display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }
  .sw-big p { font-size: 0.98rem; -webkit-line-clamp: 3; }
  .sw-small p { font-size: 0.88rem; -webkit-line-clamp: 3; }

  .sw-stats { display: grid; gap: 0.75rem; margin: 0.4rem 0 0; padding-top: 0.9rem; border-top: 1px solid var(--line); }
  .sw-big .sw-stats { grid-template-columns: repeat(4, 1fr); margin-top: auto; }
  .sw-small .sw-stats { grid-template-columns: repeat(2, 1fr); margin-top: auto; }
  .sw-stats div { display: flex; flex-direction: column; justify-content: flex-start; gap: 0.25rem; min-width: 0; }
  .sw-stats dd { order: -1; }
  .sw-stats dd { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: 1.35rem; letter-spacing: -0.02em; color: var(--ink); line-height: 1; }
  .sw-small .sw-stats dd { font-size: 1.1rem; }
  .sw-stats dt { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); line-height: 1.3; }
  .sw-go { margin-top: 0.5rem; font-weight: 600; font-size: 0.92rem; color: var(--c); }
  .sw-go span { display: inline-block; transition: transform 0.25s ease; }
  .sw-card:hover .sw-go span { transform: translateX(4px); }

  .sw-flag { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .sw-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; margin-top: 1.5rem; }
  .sw-more { display: flex; justify-content: center; margin-top: 2rem; }

  @media (max-width: 1000px) { .sw-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .sw-flag, .sw-grid { grid-template-columns: 1fr; }
    .sw-big .sw-stats { grid-template-columns: repeat(2, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sw-card, .sw-media img, .sw-go span { transition: none; }
    .sw-card:hover { transform: none; }
  }
</style>
