---
/* The lab, drawn the way an architecture diagram is drawn: a path across the
   top (internet, firewall, both switches, hypervisor), a tagged fabric, and
   the six segments hanging off it. Facts come from docs/01 and the host
   inventory in the homelab README, including Switch 1 port 1 trunking to
   pfSense and port 2 trunking to Switch 2. */

interface Host { name: string; note: string; kind: 'server' | 'pc' | 'vm' }
interface Zone {
  id: string; name: string; subnet: string; hue: string;
  hardened: boolean; hosts: Host[];
}

const zones: Zone[] = [
  {
    id: '10', name: 'Management', subnet: '192.168.10.0/24', hue: 'var(--c-cloud)', hardened: true,
    hosts: [
      { name: 'PVE01', note: 'hypervisor', kind: 'server' },
      { name: 'ADM01', note: 'admin laptop', kind: 'pc' },
      { name: 'ANS01', note: 'rebuilding', kind: 'vm' },
    ],
  },
  {
    id: '20', name: 'BlueTeam', subnet: '192.168.20.0/24', hue: 'var(--c-detection)', hardened: false,
    hosts: [
      { name: 'SIEM01', note: 'Wazuh manager', kind: 'server' },
      { name: 'SCAN01', note: 'Greenbone', kind: 'vm' },
    ],
  },
  {
    id: '30', name: 'RedTeam', subnet: '192.168.30.0/24', hue: 'var(--c-offence)', hardened: true,
    hosts: [{ name: 'KALI01', note: 'attack host', kind: 'vm' }],
  },
  {
    id: '40', name: 'DevOps', subnet: '192.168.40.0/24', hue: 'var(--c-assessment)', hardened: false,
    hosts: [
      { name: 'APP01', note: 'web apps', kind: 'server' },
      { name: 'VAULT01', note: 'planned', kind: 'vm' },
    ],
  },
  {
    id: '50', name: 'EnterpriseLAN', subnet: '192.168.50.0/24', hue: 'var(--c-identity)', hardened: true,
    hosts: [
      { name: 'DC01', note: 'corp.biirabank.com', kind: 'server' },
      { name: 'WKS01', note: 'domain joined', kind: 'vm' },
    ],
  },
  {
    id: '60', name: 'Monitoring', subnet: '192.168.60.0/24', hue: 'var(--ink-3)', hardened: false,
    hosts: [{ name: 'MON01', note: 'rebuilding', kind: 'vm' }],
  },
];

const CARD_W = 185, CARD_GAP = 18, CARD_X0 = 24, CARD_Y = 214, CARD_H = 224;
const zoneX = (i: number) => CARD_X0 + i * (CARD_W + CARD_GAP);
const SPINE_Y = 178;
---

<figure class="schematic" aria-labelledby="sch-title">
  <svg class="full" viewBox="0 0 1240 640" xmlns="http://www.w3.org/2000/svg" role="img" aria-describedby="sch-desc">
    <title id="sch-title">Biira Bank lab network architecture</title>
    <desc id="sch-desc">
      The internet reaches a pfSense firewall, which trunks on port 1 of Switch 1. Port 2 of Switch 1
      trunks to Switch 2, which carries the tagged VLANs to the Proxmox hypervisor. Six VLAN segments
      hang off the tagged fabric: Management, BlueTeam, RedTeam, DevOps, EnterpriseLAN and Monitoring.
      The domain controller on the EnterpriseLAN segment reaches Okta and Microsoft Entra ID outbound only.
    </desc>

    <defs>
      <marker id="ar" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0L10 5 0 10z" fill="currentColor" />
      </marker>
      <marker id="ar-dash" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0L10 5 0 10z" fill="var(--c-identity)" />
      </marker>
    </defs>

    {/* ---------------------------------------------------------- top path */}
    <g class="row">
      <g class="box plain" style="--d:0s">
        <rect x="24" y="30" width="146" height="78" rx="10" />
        <path class="ico" d="M40 74a9 9 0 0 1 2-17 12 12 0 0 1 22 3 7 7 0 0 1-2 14z" />
        <text x="76" y="64" class="t1">Internet</text>
        <text x="76" y="80" class="t2">untrusted</text>
      </g>
      <path class="link" d="M170 69 L204 69" marker-end="url(#ar)" style="--d:0.15s" />

      <g class="box accent" style="--d:0.2s">
        <rect x="206" y="30" width="186" height="78" rx="10" />
        <path class="ico" d="M220 52h24v18h-24zM220 61h24M228 52v9M236 61v9" />
        <text x="256" y="56" class="t1">FW01 · pfSense</text>
        <text x="256" y="72" class="t2">gateway on all six VLANs</text>
        <text x="256" y="88" class="t2 hi">default deny</text>
      </g>
      <path class="link thick" d="M392 69 L430 69" marker-end="url(#ar)" style="--d:0.35s" />
      <text x="411" y="58" class="t3 mid">trunk</text>

      <g class="box" style="--d:0.4s">
        <rect x="432" y="30" width="196" height="78" rx="10" />
        <path class="ico" d="M446 54h24v16h-24zM450 59h9l-3-3M466 65h-9l3 3" />
        <text x="482" y="56" class="t1">SW01 · TL-SG108E</text>
        <text x="482" y="72" class="t2">P1 trunk, P2 trunk</text>
        <text x="482" y="88" class="t2">P3 to P8 access, one VLAN each</text>
      </g>
      <path class="link thick" d="M628 69 L666 69" marker-end="url(#ar)" style="--d:0.55s" />
      <text x="647" y="58" class="t3 mid">P2</text>

      <g class="box" style="--d:0.6s">
        <rect x="668" y="30" width="168" height="78" rx="10" />
        <path class="ico" d="M682 54h24v16h-24zM686 59h9l-3-3M702 65h-9l3 3" />
        <text x="718" y="64" class="t1">SW02</text>
        <text x="718" y="80" class="t2">carries the tagged VLANs</text>
      </g>
      <path class="link thick" d="M836 69 L874 69" marker-end="url(#ar)" style="--d:0.75s" />

      <g class="box" style="--d:0.8s">
        <rect x="876" y="30" width="200" height="78" rx="10" />
        <path class="ico" d="M890 50h24v9h-24zM890 63h24v9h-24zM895 54.5h2M895 67.5h2" />
        <text x="926" y="56" class="t1">PVE01 · Proxmox VE</text>
        <text x="926" y="72" class="t2">one VLAN-aware bridge</text>
        <text x="926" y="88" class="t2">a guest's segment is one tag</text>
      </g>
    </g>

    {/* ------------------------------------------------- the tagged fabric */}
    <path class="link drop" d={`M540 108 L540 ${SPINE_Y}`} style="--d:0.9s" />
    <path class="link drop dashed" d={`M976 108 L976 ${SPINE_Y}`} style="--d:0.95s" />
    <path class="spine" d={`M24 ${SPINE_Y} L1216 ${SPINE_Y}`} style="--d:1s" />
    <text x="1216" y={SPINE_Y - 10} class="t3" text-anchor="end">802.1Q tagged fabric</text>

    {/* ---------------------------------------------------------- segments */}
    {zones.map((z, i) => {
      const x = zoneX(i);
      const cx = x + CARD_W / 2;
      return (
        <g class="zone" style={`--zone:${z.hue};--d:${1.05 + i * 0.07}s`}>
          <path class="link drop zn" d={`M${cx} ${SPINE_Y} L${cx} ${CARD_Y}`} />
          <rect class="card" x={x} y={CARD_Y} width={CARD_W} height={CARD_H} rx="10" />
          <rect class="cap" x={x} y={CARD_Y} width={CARD_W} height="4" rx="2" />

          <text x={x + 14} y={CARD_Y + 30} class="t1 zn-id">VLAN {z.id}</text>
          <text x={x + 14} y={CARD_Y + 48} class="t1">{z.name}</text>
          <text x={x + 14} y={CARD_Y + 66} class="t2 mono">{z.subnet}</text>

          <g class={z.hardened ? 'badge ok' : 'badge open'}>
            <rect x={x + 14} y={CARD_Y + 78} width={z.hardened ? 92 : 84} height="18" rx="9" />
            <text x={x + 14 + (z.hardened ? 46 : 42)} y={CARD_Y + 91} class="t3" text-anchor="middle">
              {z.hardened ? 'default deny' : 'permissive'}
            </text>
          </g>

          {z.hosts.map((h, j) => {
            const hy = CARD_Y + 110 + j * 38;
            return (
              <g class="host">
                <rect x={x + 12} y={hy} width={CARD_W - 24} height="32" rx="6" />
                {h.kind === 'server' && <path class="ico sm" d={`M${x + 22} ${hy + 10}h12v5h-12zM${x + 22} ${hy + 18}h12v5h-12z`} />}
                {h.kind === 'pc' && <path class="ico sm" d={`M${x + 22} ${hy + 9}h13v10h-13zM${x + 26} ${hy + 21}h5`} />}
                {h.kind === 'vm' && <path class="ico sm dash" d={`M${x + 22} ${hy + 9}h13v13h-13z`} />}
                <text x={x + 44} y={hy + 14} class="t1 sm">{h.name}</text>
                <text x={x + 44} y={hy + 26} class="t2 sm">{h.note}</text>
              </g>
            );
          })}
        </g>
      );
    })}

    {/* ------------------------------------------------- cloud identity leg */}
    <path class="link idp" d={`M${zoneX(4) + CARD_W / 2} ${CARD_Y + CARD_H} L${zoneX(4) + CARD_W / 2} 506`} marker-end="url(#ar-dash)" />
    <text x={zoneX(4) + CARD_W / 2 - 10} y={CARD_Y + CARD_H + 30} class="t3 idp-l" text-anchor="end">AD Agent, outbound only</text>

    <g class="box idp-box" style="--d:1.6s">
      <rect x={zoneX(4) - 30} y="508" width="246" height="72" rx="10" />
      <text x={zoneX(4) + 93} y="536" class="t1">Okta · Microsoft Entra ID</text>
      <text x={zoneX(4) + 93} y="554" class="t2">nothing inbound reaches DC01</text>
    </g>

    {/* ------------------------------------------------------------- legend */}
    <g class="legend">
      <path class="link thick" d="M24 600 L64 600" />
      <text x="72" y="604" class="t3">trunk, all VLANs tagged</text>
      <path class="link" d="M236 600 L276 600" />
      <text x="284" y="604" class="t3">access, one VLAN</text>
      <path class="link dashed" d="M424 600 L464 600" />
      <text x="472" y="604" class="t3">tagged to a guest, or outbound only</text>
      <rect class="swatch ok" x="756" y="593" width="14" height="14" rx="4" />
      <text x="778" y="604" class="t3">ruleset written, three of six</text>
      <rect class="swatch open" x="1010" y="593" width="14" height="14" rx="4" />
      <text x="1032" y="604" class="t3">still permissive</text>
    </g>
  </svg>

  <svg class="compact" viewBox="0 0 360 690" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="The same lab, stacked: internet, pfSense, two switches, then the six VLAN segments and the cloud identity providers.">
    <defs>
      <marker id="ar-c" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0L10 5 0 10z" fill="currentColor" />
      </marker>
    </defs>

    <g class="box plain"><rect x="0" y="0" width="360" height="40" rx="8" /><text x="16" y="25" class="t1">Internet</text><text x="344" y="25" class="t2 end">untrusted</text></g>
    <path class="link" d="M180 40 L180 58" marker-end="url(#ar-c)" />

    <g class="box accent"><rect x="0" y="60" width="360" height="46" rx="8" /><text x="16" y="82" class="t1">FW01 · pfSense</text><text x="16" y="98" class="t2">gateway on all six VLANs, default deny</text></g>
    <path class="link thick" d="M180 106 L180 124" marker-end="url(#ar-c)" />

    <g class="box"><rect x="0" y="126" width="360" height="46" rx="8" /><text x="16" y="148" class="t1">SW01 · SW02</text><text x="16" y="164" class="t2">P1 trunk to the firewall, P2 trunk to SW02, then Proxmox</text></g>
    <path class="link thick" d="M180 172 L180 190" marker-end="url(#ar-c)" />

    {zones.map((z, i) => {
      const y = 196 + i * 56;
      return (
        <g class="zone row-c" style={`--zone:${z.hue}`}>
          <rect class="card" x="0" y={y} width="360" height="48" rx="8" />
          <rect class="cap-l" x="0" y={y} width="4" height="48" rx="2" />
          <text x="16" y={y + 20} class="t1">VLAN {z.id} · {z.name}</text>
          <text x="16" y={y + 36} class="t2 mono">{z.hosts.map((h) => h.name).join(' · ')}</text>
          <g class={z.hardened ? 'badge ok' : 'badge open'}>
            <rect x={z.hardened ? 268 : 276} y={y + 15} width={z.hardened ? 76 : 68} height="17" rx="8.5" />
            <text x={z.hardened ? 306 : 310} y={y + 27} class="t3 mid">{z.hardened ? 'default deny' : 'permissive'}</text>
          </g>
        </g>
      );
    })}

    <path class="link idp" d="M180 532 L180 556" marker-end="url(#ar-c)" />
    <text x="190" y="548" class="t3 idp-l">from DC01 on VLAN 50, outbound only</text>
    <g class="box idp-box"><rect x="0" y="558" width="360" height="46" rx="8" /><text x="16" y="580" class="t1">Okta · Microsoft Entra ID</text><text x="16" y="596" class="t2">reached from DC01, never the other way</text></g>

    <g class="legend">
      <rect class="swatch ok" x="0" y="632" width="12" height="12" rx="4" />
      <text x="18" y="642" class="t3">ruleset written, three of six</text>
      <rect class="swatch open" x="0" y="660" width="12" height="12" rx="4" />
      <text x="18" y="670" class="t3">still permissive</text>
    </g>
  </svg>

  <figcaption>
    Current state. Two switches: port 1 of Switch 1 trunks to pfSense, port 2 trunks to Switch 2, which
    carries the tagged VLANs to the hypervisor. Physical hosts land on a single-VLAN access port; a guest's
    segment is one tag on its virtual NIC.
  </figcaption>
</figure>

<style>
  .schematic { margin: 0; padding: 2.5rem 0 0; color: var(--ink-2); }
  .schematic svg { width: 100%; height: auto; display: block; overflow: visible; }

  /* boxes */
  .schematic .box rect { fill: var(--paper); stroke: var(--line-2); stroke-width: 1.2; }
  .schematic .box.accent rect { stroke: var(--accent); }
  .schematic .box.plain rect { fill: var(--paper-2); stroke: var(--line); }
  .schematic .ico { fill: none; stroke: var(--ink-3); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .schematic .box.accent .ico { stroke: var(--accent); }
  .schematic .ico.sm { stroke-width: 1.3; stroke: var(--zone, var(--ink-3)); }
  .schematic .ico.sm.dash { stroke-dasharray: 3 2.5; }

  /* type */
  .schematic text { font-family: inherit; }
  .schematic .t1 { font-size: 13px; font-weight: 600; fill: var(--ink); text-anchor: middle; }
  .schematic .t2 { font-size: 10.5px; fill: var(--ink-3); text-anchor: middle; }
  .schematic .t2.hi { fill: var(--accent); font-weight: 600; }
  .schematic .t3 { font-family: var(--font-mono); font-size: 9.5px; fill: var(--ink-3); letter-spacing: 0.04em; }
  .schematic .zone .t1, .schematic .zone .t2, .schematic .row .t1, .schematic .row .t2 { text-anchor: start; }
  .schematic .t3.mid { text-anchor: middle; }
  .schematic .t1.sm { font-size: 11.5px; }
  .schematic .t2.sm { font-size: 9.5px; }
  .schematic .mono { font-family: var(--font-mono); font-size: 9.5px; }
  .schematic .zn-id { fill: var(--zone); font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; }

  /* links */
  .schematic .link { fill: none; stroke: var(--line-2); stroke-width: 1.3; }
  .schematic .link.thick { stroke: var(--ink-3); stroke-width: 2.2; }
  .schematic .link.dashed { stroke-dasharray: 5 4; }
  .schematic .link.drop { stroke: var(--line-2); }
  .schematic .link.drop.zn { stroke: var(--zone); opacity: 0.55; }
  .schematic .spine { fill: none; stroke: var(--ink-3); stroke-width: 2.2; }
  .schematic .link.idp { stroke: var(--c-identity); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .schematic .idp-l { fill: var(--c-identity); }
  .schematic .idp-box rect { stroke: var(--c-identity); fill: var(--paper); }

  /* zone cards */
  .schematic .card { fill: var(--paper); stroke: var(--line); stroke-width: 1.2; }
  .schematic .cap { fill: var(--zone); }
  .schematic .host rect { fill: var(--paper-2); stroke: none; }
  .schematic .badge rect { fill: none; stroke-width: 1; }
  .schematic .badge.ok rect { stroke: var(--ok); }
  .schematic .badge.ok .t3 { fill: var(--ok); }
  .schematic .badge.open rect { stroke: var(--warn); }
  .schematic .badge.open .t3 { fill: var(--warn); }
  .schematic .swatch.ok { fill: none; stroke: var(--ok); stroke-width: 1.4; }
  .schematic .swatch.open { fill: none; stroke: var(--warn); stroke-width: 1.4; }

  .schematic figcaption { margin-top: 1.1rem; }

  /* draw-in, the same restraint as before */
  .schematic .box, .schematic .zone, .schematic .idp-box { opacity: 0; animation: sch-fade 0.5s ease-out forwards; animation-delay: var(--d, 0s); }
  .schematic .link, .schematic .spine { stroke-dasharray: 1400; stroke-dashoffset: 1400; animation: sch-draw 0.9s ease-out forwards; animation-delay: var(--d, 0s); }
  .schematic .link.dashed, .schematic .link.idp { animation-name: sch-draw-dashed; }
  .schematic .zone .link { animation-delay: var(--d, 0s); }
  .schematic .legend .link { animation: none; stroke-dashoffset: 0; stroke-dasharray: none; }
  .schematic .legend .link.dashed { stroke-dasharray: 5 4; }
  @keyframes sch-draw { to { stroke-dashoffset: 0; } }
  @keyframes sch-draw-dashed { to { stroke-dashoffset: 0; } }
  @keyframes sch-fade { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .schematic .link, .schematic .spine { stroke-dashoffset: 0; animation: none; }
    .schematic .link.dashed, .schematic .link.idp { stroke-dasharray: 5 4; }
    .schematic .box, .schematic .zone, .schematic .idp-box { opacity: 1; animation: none; }
  }
  .schematic .compact { display: none; }
  .schematic .compact text { text-anchor: start; }
  .schematic .compact .t2.end { text-anchor: end; }
  .schematic .compact .t3.mid { text-anchor: middle; }
  .schematic .row-c .t1 { font-size: 12.5px; }
  .schematic .row-c .t2 { font-size: 9.5px; }
  .schematic .t2.end { text-anchor: end; }
  .schematic .cap-l { fill: var(--zone); }
  .schematic .compact .box rect { fill: var(--paper); stroke: var(--line-2); }
  .schematic .compact .link { stroke: var(--ink-3); }
  @media (max-width: 860px) {
    .schematic { padding-top: 2rem; }
    .schematic .full { display: none; }
    .schematic .compact { display: block; }
  }
</style>
