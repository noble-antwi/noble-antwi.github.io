---
import { SITE } from '../lib/site';

const path = Astro.url.pathname;
const items = [
  { href: '/work/', label: 'Work', match: /^\/work/ },
  { href: '/writing/', label: 'Writing', match: /^\/writing|^\/(lab-notes|learning|project-update|cloud-security|til)\// },
  { href: '/credentials/', label: 'Credentials', match: /^\/credentials/ },
  { href: '/resume/', label: 'Résumé', match: /^\/resume/ },
  { href: '/now/', label: 'Now', match: /^\/now/ },
  { href: '/contact/', label: 'Contact', match: /^\/contact/ },
];
---

<header class="site-header">
  <div class="container">
    <a class="wordmark" href="/" aria-label={`${SITE.title}, home`}>
      <span class="name">{SITE.title}</span>
      <span class="tag">{SITE.tagline}</span>
    </a>

    <div style="display:flex;align-items:center;">
      <nav class="nav" data-nav aria-label="Primary">
        {items.map((it) => (
          <a href={it.href} aria-current={it.match.test(path) ? 'page' : undefined}>{it.label}</a>
        ))}
        <a href={`https://github.com/${SITE.github}`} target="_blank" rel="noopener">GitHub ↗</a>
      </nav>
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle dark mode" title="Toggle theme">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>
      </button>
      <button class="icon-btn menu-btn" type="button" data-menu-toggle aria-label="Open navigation" aria-expanded="false" aria-controls="nav">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>
