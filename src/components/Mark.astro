---
/* The mark: a ring (an identity) with a stem (a key). Draws in currentColor so it
   works in both themes; the favicon and social cards use the filled version. */
interface Props { size?: number; class?: string }
const { size = 28, class: cls = '' } = Astro.props;
---
<svg class={`mark ${cls}`} width={size} height={size} viewBox="0 0 64 64" fill="none" aria-hidden="true">
  <circle cx="32" cy="26" r="14" stroke="currentColor" stroke-width="6" />
  <rect x="28.5" y="38" width="7" height="18" rx="3.5" fill="currentColor" />
  <rect x="35" y="47" width="8" height="5" rx="2.5" fill="currentColor" />
</svg>
