---
/* Homepage "Writing": the newest lab note as a featured card (showing the
   first figure from the note itself, or its social card), the next four
   posts as a compact list, and the series as coloured cards. */
import { getCollection } from 'astro:content';
import { postUrl, postPath, formatDate, isoDate, categoryLabel, seriesFor, byDateDesc, SERIES } from '../lib/site';

const posts = (await getCollection('posts')).sort(byDateDesc);
const featured = posts.find((p) => p.data.category === 'lab-notes') ?? posts[0];
const rest = posts.filter((p) => p !== featured).slice(0, 4);

// The first image in the note's own body, if it has one.
const firstImage = (body: string | undefined) => {
  const m = (body ?? '').match(/!\[([^\]]*)\]\((\/[^)\s]+)\)/);
  return m ? { alt: m[1], src: m[2] } : null;
};
const fig = firstImage(featured.body);
const figSrc = fig?.src ?? `/og/${postPath(featured)}.png`;
const figAlt = fig?.alt ?? '';

const SERIES_COLOUR: Record<string, string> = {
  homelab: 'detection',
  soc: 'offence',
  'identity-certs': 'identity',
  'az-900': 'cloud',
  vault: 'assessment',
};
const series = SERIES.map((s) => ({ ...s, count: posts.filter(s.match).length, latest: posts.find(s.match) }))
  .filter((s) => s.count > 1);
const topicOf = (cat: string) => (cat === 'lab-notes' ? 'detection' : cat === 'learning' ? 'cloud' : 'detection');
---

<section class="section wr" aria-labelledby="wr-h">
  <div class="wr-head">
    <div>
      <span class="kicker">Writing</span>
      <h2 class="display h2" id="wr-h">Notes from the lab and the study desk.</h2>
      <p class="wr-lede">Written as I go, so they keep the mistakes as well as the fixes. {posts.length} notes across {series.length} series.</p>
    </div>
    <a class="btn btn-ghost" href="/writing/">All writing <span aria-hidden="true">→</span></a>
  </div>

  <div class="wr-top">
    <a class="wr-feature" href={postUrl(featured)} style={`--c: var(--c-${topicOf(featured.data.category)})`}>
      <div class="wr-fig"><img src={figSrc} alt={figAlt} loading="lazy" decoding="async" /></div>
      <div class="wr-fbody">
        <span class="wr-meta"><b>Latest {categoryLabel(featured.data.category).toLowerCase().replace(/s$/, '')}</b> · <time datetime={isoDate(featured.data.date)}>{formatDate(featured.data.date, 'short')}</time>{featured.data.read_time ? ` · ${featured.data.read_time} min read` : ''}</span>
        <h3>{featured.data.title}</h3>
        <p>{featured.data.description}</p>
        <span class="wr-go">Read the note <span aria-hidden="true">→</span></span>
      </div>
    </a>

    <ol class="wr-list" aria-label="More recent writing">
      {rest.map((p) => {
        const s = seriesFor(p);
        return (
          <li style={`--c: var(--c-${s ? SERIES_COLOUR[s.id] ?? 'detection' : topicOf(p.data.category)})`}>
            <a class="wr-row" href={postUrl(p)}>
              <span class="wr-rmeta"><time datetime={isoDate(p.data.date)}>{formatDate(p.data.date, 'short')}</time><span>{s ? s.title : categoryLabel(p.data.category)}</span></span>
              <span class="wr-rtitle">{p.data.title}</span>
              {p.data.read_time && <span class="wr-rtime">{p.data.read_time} min</span>}
            </a>
          </li>
        );
      })}
    </ol>
  </div>

  <div class="wr-series" aria-label="Series">
    {series.map((s) => (
      <a class="wr-s" href={`/writing/?posts=${s.id}`} style={`--c: var(--c-${SERIES_COLOUR[s.id] ?? 'detection'})`}>
        <span class="wr-scount">{s.count}<small>notes</small></span>
        <span class="wr-stitle">{s.title}</span>
        <span class="wr-sblurb">{s.blurb}</span>
      </a>
    ))}
  </div>
</section>

<style is:global>
  .wr-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .wr-head h2 { max-width: 34rem; margin-top: 0.4rem; }
  .wr-lede { color: var(--ink-2); margin: 0.6rem 0 0; max-width: 34rem; }

  .wr-top { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 1.5rem; align-items: stretch; }

  .wr-feature { position: relative; display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: var(--paper); color: inherit; text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease; }
  .wr-feature::before { content: ''; position: absolute; inset: 0 0 auto; height: 4px; background: var(--c); z-index: 2; }
  .wr-feature:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--c) 55%, var(--line)); box-shadow: 0 18px 40px -18px color-mix(in srgb, var(--c) 45%, transparent); }
  .wr-fig { position: relative; aspect-ratio: 16 / 8.5; background: var(--paper-2); border-bottom: 1px solid var(--line); overflow: hidden; }
  .wr-fig img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 0.9rem; box-sizing: border-box; transition: transform 0.6s ease; }
  .wr-feature:hover .wr-fig img { transform: scale(1.025); }
  .wr-fbody { display: flex; flex-direction: column; gap: 0.65rem; padding: 1.4rem 1.6rem 1.6rem; flex: 1; }
  .wr-meta { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .wr-meta b { color: var(--c); font-weight: 600; }
  .wr-fbody h3 { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.5rem, 2.6vw, 2.1rem); letter-spacing: -0.025em; line-height: 1.08; margin: 0; color: var(--ink); }
  .wr-fbody p { margin: 0; color: var(--ink-2); line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .wr-go { margin-top: auto; padding-top: 0.4rem; font-weight: 600; color: var(--c); }
  .wr-go span { display: inline-block; transition: transform 0.25s ease; }
  .wr-feature:hover .wr-go span { transform: translateX(4px); }

  .wr-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.75rem; }
  .wr-list li { flex: 1; display: flex; }
  .wr-row { position: relative; flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 0.4rem; padding: 1rem 3.4rem 1rem 1.25rem; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); color: inherit; text-decoration: none; overflow: hidden;
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease; }
  .wr-row::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--c); }
  .wr-row:hover { border-color: color-mix(in srgb, var(--c) 55%, var(--line)); background: color-mix(in srgb, var(--c) 5%, var(--paper)); transform: translateX(3px); }
  .wr-rmeta { display: flex; gap: 0.6rem; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); flex-wrap: wrap; }
  .wr-rmeta span { color: var(--c); }
  .wr-rtitle { font-weight: 700; font-size: 1.08rem; line-height: 1.3; color: var(--ink); letter-spacing: -0.01em; }
  .wr-rtime { position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-3); }

  .wr-series { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .wr-s { position: relative; display: flex; flex-direction: column; gap: 0.45rem; padding: 1.15rem 1.2rem 1.25rem; border-radius: 14px; text-decoration: none; color: inherit;
    background: color-mix(in srgb, var(--c) 7%, var(--paper)); border: 1px solid color-mix(in srgb, var(--c) 25%, var(--line)); transition: transform 0.25s ease, border-color 0.25s ease, background 0.25s ease; }
  .wr-s:hover { transform: translateY(-3px); border-color: var(--c); background: color-mix(in srgb, var(--c) 11%, var(--paper)); }
  .wr-scount { font-family: var(--font-display); font-weight: 800; font-size: 1.9rem; line-height: 1; letter-spacing: -0.03em; color: var(--c); display: flex; align-items: baseline; gap: 0.35rem; }
  .wr-scount small { font-family: var(--font-mono); font-size: 0.65rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
  .wr-stitle { font-weight: 700; color: var(--ink); line-height: 1.25; }
  .wr-sblurb { font-size: 0.84rem; line-height: 1.5; color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  .wr-feature:focus-visible, .wr-row:focus-visible, .wr-s:focus-visible { outline: 3px solid var(--c); outline-offset: 3px; }

  @media (max-width: 900px) { .wr-top { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) {
    .wr-feature, .wr-fig img, .wr-row, .wr-s, .wr-go span { transition: none; }
    .wr-feature:hover, .wr-row:hover, .wr-s:hover { transform: none; }
  }
</style>
